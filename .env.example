# Atelier B MCP Server Configuration
# Copy this file to .env and adjust the values

# Path to Atelier B installation directory
ATELIERB_PATH=C:/Program Files/Atelier B Community Edition 24.04.2 24.04.2

# Path to B projects workspace
ATELIERB_WORKSPACE=C:/Work/B/WK25.02

# bbatch executable name (relative to ATELIERB_PATH/bin) or absolute path
ATELIERB_BBATCH_CMD=bbatch.exe

# Command timeout in seconds
ATELIERB_COMMAND_TIMEOUT=120
